{
  "manifest_version": 3,
  "name": "New Download Manager Integration",
  "version": "1.8.0",
  "description": "Hands browser downloads to New Download Manager and shows a download panel on web video and audio players and on selected links.",
  "permissions": ["downloads", "cookies", "contextMenus", "webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }],
  "browser_specific_settings": {
    "gecko": { "id": "ndm@newdownloadmanager", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } }
  }
}
